        <technology>HR_Tech_AnimalHusbandry</technology>
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>HR_Research_SeedSelection</defName>
    <label>seed selection</label>
