<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Historical branches occupy the blank right-side band of the main tree; progression runs left to right and y separates branches. -->
  <ResearchProjectDef>
    <defName>HR_Research_BasicFarming</defName>
    <label>basic farming</label>
    <description>Develop basic crop tending practices. Historical horizon: broad evidence places early cultivation roughly between 8000 and 5000 BCE; this is not a precise invention date.</description>
    <baseCost>400</baseCost>
    <techLevel>Neolithic</techLevel>
    <researchViewX>5.00</researchViewX>
    <researchViewY>0.05</researchViewY>
  
    <tab>HR_HistoricalTechnologies</tab>
    <modExtensions>
      <li Class="HistoricalRimWorld.Technology.HistoricalTechExtension">
        <IsHistoricalTechnology>true</IsHistoricalTechnology>
        <technology>HR_Tech_BasicFarming</technology>
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>HR_Research_AnimalHusbandry</defName>
    <label>animal husbandry</label>
    <description>Improve animal care and breeding practices. Historical horizon: evidence for early domestication spans roughly 9000 to 5000 BCE and varies by region.</description>
    <baseCost>400</baseCost>
    <techLevel>Neolithic</techLevel>
    <researchViewX>5.00</researchViewX>
    <researchViewY>1.00</researchViewY>
  
    <tab>HR_HistoricalTechnologies</tab>
