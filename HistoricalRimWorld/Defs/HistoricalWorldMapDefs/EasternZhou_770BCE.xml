<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Editable surface map for the Eastern Zhou prototype scenario.

    Coordinates use longitude (-180..180) and latitude (-90..90) in degrees.
    Each override is assigned to the nearest RimWorld WorldGrid tile center.
    The game log reports the resolved tile ID and center. Unlisted tiles inherit
    these defaults. These sample points are scattered across China and do not
    constitute a geographically accurate map.

    On RimWorld 1.6 surface tiles, elevation <= 0 is water-covered.
    The entries below are scattered examples only; they are not a China map.
  -->
  <HistoricalRimWorld.World.HistoricalWorldMapDef>
    <defName>HR_EZ_WorldMap_770BCE</defName>
    <label>Eastern Zhou editable prototype map</label>
    <defaultBiome>TemperateForest</defaultBiome>
    <defaultElevation>0.1</defaultElevation>
    <defaultHilliness>Flat</defaultHilliness>
    <tileOverrides>
      <!-- Northwest edge sample: forest hills -->
      <li>
        <longitude>101.0</longitude>
        <latitude>41.0</latitude>
        <biome>BorealForest</biome>
        <elevation>0.22</elevation>
        <hilliness>LargeHills</hilliness>
      </li>
      <!-- Southwest edge sample: mountains -->
      <li>
        <longitude>105.0</longitude>
        <latitude>28.0</latitude>
        <biome>TropicalRainforest</biome>
        <elevation>0.3</elevation>
        <hilliness>Mountainous</hilliness>
      </li>
      <!-- Northern sample: small hills -->
      <li>
        <longitude>109.0</longitude>
        <latitude>41.0</latitude>
        <biome>TemperateForest</biome>
        <elevation>0.18</elevation>
        <hilliness>SmallHills</hilliness>
      </li>
      <!-- Central sample: temperate hills -->
      <li>
        <longitude>113.0</longitude>
        <latitude>34.0</latitude>
        <biome>TemperateForest</biome>
        <elevation>0.16</elevation>
        <hilliness>SmallHills</hilliness>
      </li>
      <!-- Eastern sample: flat desert -->
      <li>
        <longitude>121.0</longitude>
        <latitude>40.0</latitude>
        <biome>Desert</biome>
        <elevation>0.1</elevation>
        <hilliness>Flat</hilliness>
      </li>
      <!-- South edge sample: water; elevation <= 0 -->
      <li>
        <longitude>121.0</longitude>
        <latitude>27.0</latitude>
        <biome>TemperateForest</biome>
        <elevation>0</elevation>
        <hilliness>Flat</hilliness>
      </li>
    </tileOverrides>
    <!--
      Named world-map locations. Coordinates are longitude/latitude in degrees.
      Choose a marker WorldObjectDef to select its icon; add factionDef to tint the
      icon with that generated faction's color. Descriptions appear when selected.
    -->
    <locations>
      <li>
        <locationId>ExampleTown</locationId>
        <label>示例乡镇</label>
        <description>乡镇标记格式示例；尚未指定历史派系。</description>
        <longitude>104.5</longitude>
        <latitude>29.5</latitude>
        <worldObjectDef>HR_MapMarker_Town</worldObjectDef>
      </li>
      <li>
        <locationId>ExampleWalledCity</locationId>
        <label>示例大城市</label>
        <description>大城市标记格式示例；尚未指定历史派系。</description>
        <longitude>119.5</longitude>
        <latitude>40.5</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
      </li>
      <li>
        <locationId>luoyi</locationId>
        <label>洛邑（洛阳）</label>
        <description>所属派系：周王室（国都）</description>
        <longitude>112.437111</longitude>
        <latitude>34.674611</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_EasternZhou</factionDef>
      </li>
      <li>
        <locationId>linzi</locationId>
        <label>临淄（淄博）</label>
        <description>所属派系：齐国（国都）</description>
        <longitude>118.3500</longitude>
        <latitude>36.8200</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Qi</factionDef>
      </li>
      <li>
        <locationId>qufu</locationId>
        <label>曲阜（济宁）</label>
        <description>所属派系：鲁国（国都）</description>
        <longitude>116.99</longitude>
        <latitude>35.60</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Lu</factionDef>
      </li>
      <li>
        <locationId>xinzheng</locationId>
        <label>新郑</label>
        <description>所属派系：郑国（国都）</description>
        <longitude>113.74</longitude>
        <latitude>34.4</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Zheng</factionDef>
      </li>
      <li>
        <locationId>shangqiu</locationId>
        <label>商丘</label>
        <description>所属派系：宋国（国都）</description>
        <longitude>115.65</longitude>
        <latitude>34.42</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Song</factionDef>
      </li>
      <li>
        <locationId>xintian</locationId>
        <label>新田（临汾）</label>
        <description>所属派系：晋国。新田作为晋都的年代晚于本剧本范围，故此处不标为国都。</description>
        <longitude>111.3700</longitude>
        <latitude>35.62</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Jin</factionDef>
      </li>
      <li>
        <locationId>yongcheng</locationId>
        <label>雍城（宝鸡）</label>
        <description>所属派系：秦国。雍城成为秦都的年代晚于本剧本范围，故此处不标为国都。</description>
        <longitude>107.38</longitude>
        <latitude>34.46</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Qin</factionDef>
      </li>
      <li>
        <locationId>yingdu</locationId>
        <label>郢都（荆州）</label>
        <description>所属派系：楚国。郢成为楚都的年代晚于本剧本范围，故此处不标为国都。</description>
        <longitude>112.2</longitude>
        <latitude>30.35</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Chu</factionDef>
      </li>
      <li>
        <locationId>jicheng</locationId>
        <label>蓟城（北京）</label>
        <description>所属政权：燕国；当前剧本尚未配置燕国派系。本时间段不标为国都。</description>
        <longitude>116.32</longitude>
        <latitude>39.9</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
      </li>
      <li>
        <locationId>wudu</locationId>
        <label>吴都（苏州）</label>
        <description>所属政权：吴国；当前剧本尚未配置吴国派系。苏州作为吴都的标注不代表前770—740年的都城。</description>
        <longitude>120.62</longitude>
        <latitude>31.32</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
      </li>
      <li>
        <locationId>kuaiji</locationId>
        <label>会稽（绍兴）</label>
        <description>所属政权：越国；当前剧本尚未配置越国派系。会稽作为越都的年代晚于本剧本范围。</description>
        <longitude>120.58</longitude>
        <latitude>30</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
      </li>
      <li>
        <locationId>chen</locationId>
        <label>陈（周口）</label>
        <description>所属政权：陈国（国都）；当前剧本尚未配置陈国派系。</description>
        <longitude>114.88</longitude>
        <latitude>33.78</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
      </li>
      <li>
        <locationId>shangcai</locationId>
        <label>上蔡（驻马店）</label>
        <description>所属政权：蔡国（国都）；当前剧本尚未配置蔡国派系。</description>
        <longitude>114.27</longitude>
        <latitude>33.26</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
      </li>
      <li>
        <locationId>diqiu</locationId>
        <label>帝丘（濮阳）</label>
        <description>所属派系：卫国。帝丘成为卫都的年代晚于本剧本范围，故此处不标为国都。</description>
        <longitude>115.03</longitude>
        <latitude>35.76</latitude>
        <worldObjectDef>HR_MapMarker_City</worldObjectDef>
        <factionDef>HR_Faction_Wei</factionDef>
      </li>
    </locations>
  </HistoricalRimWorld.World.HistoricalWorldMapDef>
</Defs>
