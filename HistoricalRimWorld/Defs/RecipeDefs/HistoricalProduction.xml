<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef><defName>HR_MakeSeedStock</defName><label>save seed stock</label><description>Reserve selected grain as seed stock for storage or exchange.</description><jobString>Saving seed stock.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Plants</workSkill><workAmount>250</workAmount><ingredients><li><filter><thingDefs><li>RawRice</li></thingDefs></filter><count>10</count></li></ingredients><fixedIngredientFilter><thingDefs><li>RawRice</li></thingDefs></fixedIngredientFilter><products><HR_SelectedSeeds>1</HR_SelectedSeeds></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_BasicFarming</requiredTechnology></li></modExtensions></RecipeDef>
  <RecipeDef><defName>HR_CraftBronzeToolBelt</defName><label>craft bronze tool belt</label><description>Craft wearable bronze tools that improve the wearer's general work speed by 8%.</description><jobString>Making a bronze tool belt.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill><skillRequirements><Crafting>3</Crafting></skillRequirements><workAmount>1200</workAmount><ingredients><li><filter><thingDefs><li>HR_Bronze</li></thingDefs></filter><count>2</count></li><li><filter><thingDefs><li>WoodLog</li></thingDefs></filter><count>4</count></li></ingredients><fixedIngredientFilter><thingDefs><li>HR_Bronze</li><li>WoodLog</li></thingDefs></fixedIngredientFilter><products><HR_BronzeToolBelt>1</HR_BronzeToolBelt></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_BronzeTools</requiredTechnology></li></modExtensions></RecipeDef>
  <RecipeDef><defName>HR_CraftIronToolBelt</defName><label>craft iron tool belt</label><description>Craft wearable iron tools that improve the wearer's general work speed by 12%.</description><jobString>Making an iron tool belt.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill><skillRequirements><Crafting>4</Crafting></skillRequirements><workAmount>1600</workAmount><ingredients><li><filter><thingDefs><li>HR_BloomIron</li></thingDefs></filter><count>2</count></li><li><filter><thingDefs><li>WoodLog</li></thingDefs></filter><count>4</count></li></ingredients><fixedIngredientFilter><thingDefs><li>HR_BloomIron</li><li>WoodLog</li></thingDefs></fixedIngredientFilter><products><HR_IronToolBelt>1</HR_IronToolBelt></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_IronFarmTools</requiredTechnology></li></modExtensions></RecipeDef>
  <RecipeDef><defName>HR_ProspectCopper</defName><label>sort copper-bearing stone</label><description>Recover a small amount of copper-bearing material from ordinary stone fragments; this deliberately simplified route does not generate geological deposits.</description><jobString>Sorting copper-bearing stone.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Mining</workSkill><skillRequirements><Mining>2</Mining></skillRequirements><workAmount>1200</workAmount><ingredients><li><filter><thingDefs><li>ChunkGranite</li><li>ChunkSandstone</li><li>ChunkLimestone</li><li>ChunkSlate</li><li>ChunkMarble</li></thingDefs></filter><count>4</count></li></ingredients><fixedIngredientFilter><thingDefs><li>ChunkGranite</li><li>ChunkSandstone</li><li>ChunkLimestone</li><li>ChunkSlate</li><li>ChunkMarble</li></thingDefs></fixedIngredientFilter><products><HR_CopperOre>2</HR_CopperOre></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_CopperMining</requiredTechnology></li></modExtensions></RecipeDef>
  <RecipeDef><defName>HR_ProspectTin</defName><label>sort tin-bearing stone</label><description>Recover tin-bearing material from ordinary stone fragments using an abstracted prospecting process.</description><jobString>Sorting tin-bearing stone.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Mining</workSkill><skillRequirements><Mining>3</Mining></skillRequirements><workAmount>1600</workAmount><ingredients><li><filter><thingDefs><li>ChunkGranite</li><li>ChunkSandstone</li><li>ChunkLimestone</li><li>ChunkSlate</li><li>ChunkMarble</li></thingDefs></filter><count>5</count></li></ingredients><fixedIngredientFilter><thingDefs><li>ChunkGranite</li><li>ChunkSandstone</li><li>ChunkLimestone</li><li>ChunkSlate</li><li>ChunkMarble</li></thingDefs></fixedIngredientFilter><products><HR_TinOre>1</HR_TinOre></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_CopperMining</requiredTechnology></li></modExtensions></RecipeDef>
  <RecipeDef><defName>HR_ProspectIron</defName><label>sort iron-bearing stone</label><description>Produce a limited quantity of iron-bearing material from stone fragments; this is a gameplay abstraction rather than a placed ore deposit.</description><jobString>Sorting iron-bearing stone.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Mining</workSkill><skillRequirements><Mining>4</Mining></skillRequirements><workAmount>1800</workAmount><ingredients><li><filter><thingDefs><li>ChunkGranite</li><li>ChunkSandstone</li><li>ChunkLimestone</li><li>ChunkSlate</li><li>ChunkMarble</li></thingDefs></filter><count>6</count></li></ingredients><fixedIngredientFilter><thingDefs><li>ChunkGranite</li><li>ChunkSandstone</li><li>ChunkLimestone</li><li>ChunkSlate</li><li>ChunkMarble</li></thingDefs></fixedIngredientFilter><products><HR_IronOre>1</HR_IronOre></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_EarlyIronworking</requiredTechnology></li></modExtensions></RecipeDef>
  <RecipeDef><defName>HR_SelectSeedsRice</defName><label>select rice seed stock</label><description>Sort a batch of rice for the next planting season; the resulting seed stock is a tradable item and does not alter vanilla crop genetics.</description><jobString>Selecting rice seeds.</jobString><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Plants</workSkill><workAmount>300</workAmount><ingredients><li><filter><thingDefs><li>RawRice</li></thingDefs></filter><count>10</count></li></ingredients><fixedIngredientFilter><thingDefs><li>RawRice</li></thingDefs></fixedIngredientFilter><products><HR_SelectedSeeds>3</HR_SelectedSeeds></products><modExtensions><li Class="HistoricalRimWorld.Production.HistoricalTechnologyRequirementExtension"><requiredTechnology>HR_Tech_SeedSelection</requiredTechnology></li></modExtensions></RecipeDef>
